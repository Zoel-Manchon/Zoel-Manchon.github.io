---
/*
 * The running head of the notebook.
 *
 * A bound volume repeats its identity on every page, so this rail stays put
 * while the log scrolls: who wrote it, where you are, and the two controls that
 * change how it is read — language and ink.
 */
import { site } from '@/data/site';
---

<header class="running-head">
  <div class="site-container running-head-inner">
    <a class="colophon" href="#top">
      <span class="colophon-mark">{site.shortName}</span>
      <span class="colophon-name">{site.name}</span>
    </a>

    <nav class="running-nav" aria-label="Sections">
      <a href="#index">
        <span class="lang-en">Index</span>
        <span class="lang-es">Índice</span>
      </a>
      <a href="#annex">
        <span class="lang-en">Evidence</span>
        <span class="lang-es">Pruebas</span>
      </a>
      <a href="#log">
        <span class="lang-en">Log</span>
        <span class="lang-es">Registro</span>
      </a>
      <a href="#commissions">
        <span class="lang-en">Commissions</span>
        <span class="lang-es">Encargos</span>
      </a>
      <a href="#colophon">
        <span class="lang-en">Contact</span>
        <span class="lang-es">Contacto</span>
      </a>
    </nav>

    <div class="running-controls">
      <button id="language-toggle" class="stamp-button" type="button" aria-label="Switch to Spanish">
        <span class="stamp-label" aria-hidden="true">ES</span>
      </button>
      <button id="theme-toggle" class="stamp-button" type="button" aria-label="Switch to light mode" aria-pressed="true">
        <svg class="ink-icon ink-icon-sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="3.5"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"></path>
        </svg>
        <svg class="ink-icon ink-icon-moon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.5 14.6A8.6 8.6 0 0 1 9.4 3.5 8.8 8.8 0 1 0 20.5 14.6Z"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const themeToggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
  const languageToggle = document.querySelector<HTMLButtonElement>('#language-toggle');
  const languageLabel = document.querySelector<HTMLElement>('.stamp-label');
  const themeMeta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  const descriptionMeta = document.querySelector<HTMLMetaElement>('meta[name="description"]');

  const syncControls = () => {
    const isDark = root.dataset.theme === 'dark';
    const isSpanish = root.dataset.lang === 'es';

    themeToggle?.setAttribute('aria-pressed', String(isDark));
    themeToggle?.setAttribute(
      'aria-label',
      isSpanish
        ? isDark ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro'
        : isDark ? 'Switch to light mode' : 'Switch to dark mode',
    );

    // The stamp shows the language you would get, not the one you are reading.
    languageToggle?.setAttribute('aria-label', isSpanish ? 'Switch to English' : 'Cambiar a español');
    if (languageLabel) languageLabel.textContent = isSpanish ? 'EN' : 'ES';
    if (themeMeta) themeMeta.content = isDark ? '#0a0a0a' : '#f4f4f2';

    document.title = isSpanish
      ? 'Zoel Arias Manchón — Cuaderno de ingeniería'
      : 'Zoel Arias Manchón — Engineering logbook';

    if (descriptionMeta) {
      descriptionMeta.content = isSpanish
        ? 'Cuaderno de ingeniería: trece sistemas construidos entre junio y septiembre de 2026 — IoT, seguridad aplicada, backends en tiempo real y herramientas nativas.'
        : 'An engineering logbook: thirteen systems built between June and September 2026 — IoT, applied security, real-time backends and native tooling.';
    }
  };

  themeToggle?.addEventListener('click', () => {
    const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = nextTheme;
    localStorage.setItem('theme', nextTheme);
    syncControls();
  });

  languageToggle?.addEventListener('click', () => {
    const nextLanguage = root.dataset.lang === 'en' ? 'es' : 'en';
    root.dataset.lang = nextLanguage;
    root.lang = nextLanguage;
    localStorage.setItem('language', nextLanguage);
    syncControls();
  });

  syncControls();
</script>
