---
/*
 * The volume, read in one pass.
 *
 * Masthead → index of entries → evidence annex → the log itself → commissions
 * and archive → colophon. The index comes before the annex so a reader gets the
 * map first; the annex comes before the log so the proof arrives before the
 * prose asking to be believed.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Annex from '@/components/Annex.astro';
import LogEntry from '@/components/LogEntry.astro';
import Footer from '@/components/Footer.astro';
import { projects, site, archive, services, logbook } from '@/data/site';
import { dayLabel, groupByMonth, monthLabel } from '@/lib/dates';

const groups = groupByMonth(projects);
const opened = monthLabel(logbook.opened);
const latest = monthLabel(logbook.latest);
---

<BaseLayout
  title={`${site.name} — Engineering logbook`}
  description="An engineering logbook: thirteen systems built between June and September 2026 — IoT, applied security, real-time backends and native tooling."
>
  <div id="top" class="volume">
    <a class="skip-link" href="#masthead">
      <span class="lang-en">Skip to content</span>
      <span class="lang-es">Saltar al contenido</span>
    </a>

    <Header />

    <main>
      <header id="masthead" class="masthead site-container">
        <div class="masthead-head">
          <div class="masthead-identity">
            <p class="masthead-kicker">
              <span class="lang-en">Engineering logbook · systems record</span>
              <span class="lang-es">Cuaderno de ingeniería · registro de sistemas</span>
            </p>
            <h1>{site.name}</h1>
            <p class="masthead-line">
              <span class="lang-en">
                Security engineer. Whole systems, with the security designed in rather than added afterwards.
              </span>
              <span class="lang-es">
                Ingeniero de seguridad. Sistemas completos, con la seguridad diseñada dentro y no añadida después.
              </span>
            </p>
          </div>

          <dl class="masthead-figures">
            <div>
              <dt><span class="lang-en">Opened</span><span class="lang-es">Abierto</span></dt>
              <dd><span class="lang-en">{opened.en}</span><span class="lang-es">{opened.es}</span></dd>
            </div>
            <div>
              <dt><span class="lang-en">Entries</span><span class="lang-es">Entradas</span></dt>
              <dd>{logbook.count}</dd>
            </div>
            <div>
              <dt><span class="lang-en">Last worked</span><span class="lang-es">Última mano</span></dt>
              <dd><span class="lang-en">{latest.en}</span><span class="lang-es">{latest.es}</span></dd>
            </div>
            <div>
              <dt><span class="lang-en">Source</span><span class="lang-es">Origen</span></dt>
              <dd>
                <a href={site.github} target="_blank" rel="noreferrer">github.com/Zoel-Manchon <span aria-hidden="true">↗</span></a>
              </dd>
            </div>
          </dl>
        </div>

        <div class="masthead-summary">
          <div class="summary-prose">
            <p class="margin-label">
              <span class="lang-en">Summary</span>
              <span class="lang-es">Resumen</span>
            </p>
            <p class="lang-en">
              This notebook records thirteen systems built between June and September 2026: firmware, telemetry
              pipelines, backend services, security tooling and a Linux distribution compiled from scratch. Each
              entry keeps the day it was opened, a real line of the program’s output, and the handful of decisions
              holding it up.
            </p>
            <p class="lang-es">
              Este cuaderno recoge trece sistemas construidos entre junio y septiembre de 2026: firmware,
              canalizaciones de telemetría, servicios backend, herramientas de seguridad y una distribución Linux
              compilada desde cero. Cada entrada conserva el día en que se abrió, una línea real de la salida del
              programa y el puñado de decisiones que la sostienen.
            </p>
            <p class="summary-muted lang-en">
              It reads in order, like a notebook. The index below is the shortcut; nothing opens in another tab
              unless you ask for it.
            </p>
            <p class="summary-muted lang-es">
              Se lee en orden, como un cuaderno. El índice de abajo es el atajo; nada se abre en otra pestaña sin
              que se pida.
            </p>
          </div>

          <aside class="summary-margin">
            <p class="margin-label margin-label-accent">
              <span class="lang-en">Marginal note</span>
              <span class="lang-es">Nota al margen</span>
            </p>
            <p class="lang-en">
              Open to a role or to commissioned work. Every claim in this notebook has verifiable output behind it,
              and the dates are the repositories’ own.
            </p>
            <p class="lang-es">
              Abierto a un puesto o a trabajo por encargo. Cada afirmación de este cuaderno tiene salida verificable
              detrás, y las fechas son las de los propios repositorios.
            </p>
          </aside>
        </div>
      </header>

      <section id="index" class="index-section site-container" aria-labelledby="index-title">
        <div class="rule-heading">
          <h2 id="index-title">
            <span class="lang-en">Index of entries</span>
            <span class="lang-es">Índice de entradas</span>
          </h2>
          <p class="rule-tag">01–{String(logbook.count).padStart(2, '0')}</p>
        </div>

        <ol class="index-list">
          {projects.map((project) => {
            const day = dayLabel(project.started);
            return (
              <li class="index-row">
                <a href={`#entry-${project.number}`}>
                  <span class="index-number">{project.number}</span>
                  <span class="index-title">
                    <span class="lang-en">{project.title.en}</span>
                    <span class="lang-es">{project.title.es}</span>
                  </span>
                  <span class="index-repo">{project.repo}</span>
                  <span class="index-date">
                    <span class="lang-en">{day.en}</span>
                    <span class="lang-es">{day.es}</span>
                  </span>
                </a>
              </li>
            );
          })}
        </ol>
      </section>

      <Annex />

      <section id="log" class="log-section site-container" aria-labelledby="log-title">
        <h2 id="log-title" class="sr-only">
          <span class="lang-en">The log</span>
          <span class="lang-es">El registro</span>
        </h2>

        {groups.map((group) => (
          <div class="log-group">
            <div class="group-heading">
              <h3>
                <span class="lang-en">{group.label.en}</span>
                <span class="lang-es">{group.label.es}</span>
              </h3>
              <span class="group-rule" aria-hidden="true"></span>
              <p class="group-count">
                <span class="lang-en">{group.rows.length} {group.rows.length === 1 ? 'entry' : 'entries'}</span>
                <span class="lang-es">{group.rows.length} {group.rows.length === 1 ? 'entrada' : 'entradas'}</span>
              </p>
            </div>

            {group.rows.map((project) => <LogEntry project={project} />)}
          </div>
        ))}
      </section>

      <section id="commissions" class="back-matter site-container" aria-labelledby="commissions-title">
        <div class="back-column">
          <div class="rule-heading">
            <h2 id="commissions-title">
              <span class="lang-en">Commissions</span>
              <span class="lang-es">Encargos</span>
            </h2>
            <p class="rule-tag">
              <span class="lang-en">freelance</span>
              <span class="lang-es">por encargo</span>
            </p>
          </div>

          <ol class="commission-list">
            {services.map((service) => (
              <li class="commission-row">
                <span class="commission-number">{service.number}</span>
                <div class="commission-body">
                  <h3>
                    <span class="lang-en">{service.title.en}</span>
                    <span class="lang-es">{service.title.es}</span>
                  </h3>
                  <p class="lang-en">{service.description.en}</p>
                  <p class="lang-es">{service.description.es}</p>
                  <ul class="commission-deliverables">
                    {service.deliverables.map((item) => (
                      <li>
                        <span class="lang-en">{item.en}</span>
                        <span class="lang-es">{item.es}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            ))}
          </ol>

          <p class="commission-note lang-en">
            Every installation can include a monthly maintenance plan — monitoring, updates and support — so it
            keeps working after I leave.
          </p>
          <p class="commission-note lang-es">
            Toda instalación puede incluir plan de mantenimiento mensual — monitorización, actualizaciones y
            soporte — para que siga funcionando cuando yo ya no esté.
          </p>
        </div>

        <div class="back-column" id="archive">
          <div class="rule-heading">
            <h2>
              <span class="lang-en">Loose leaves</span>
              <span class="lang-es">Hojas sueltas</span>
            </h2>
            <p class="rule-tag">{archive.length}</p>
          </div>

          <ul class="archive-list">
            {archive.map((entry) => {
              const day = dayLabel(entry.started);
              return (
                <li class="archive-row">
                  <a href={entry.url} target="_blank" rel="noreferrer">
                    <span class="archive-name">{entry.name}</span>
                    <span class="archive-date">
                      <span class="lang-en">{day.en}</span>
                      <span class="lang-es">{day.es}</span>
                    </span>
                    <span class="archive-desc lang-en">{entry.description.en}</span>
                    <span class="archive-desc lang-es">{entry.description.es}</span>
                    <span class="archive-tags">{entry.tags.join(' · ')}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>
